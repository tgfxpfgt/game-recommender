# Game Recommender - 编辑器规范（v4.1.2）
# 与 eslint.config.js / .gitattributes 互补的纯文本约定（零依赖）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
