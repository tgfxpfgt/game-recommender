{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "chrome"
    ]
  },
  "include": [
    "content/**/*.js",
    "options/**/*.js",
    "popup/**/*.js",
    "dashboard/**/*.js",
    "freegames/**/*.js",
    "adapters/**/*.js",
    "shared/**/*.js",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "background",
    "data",
    "lib"
  ]
}
