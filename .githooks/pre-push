#!/bin/sh
# Game Recommender pre-push 钩子（v7.0.7）
# push 前运行完整门禁（lint + typecheck + vitest）——坏提交在本地拦截，
# 避免触发远端 CI 红灯。E2E/覆盖率门禁由发布流程负责（本地可另行执行）。
# pre-push hook: full check gate (lint + typecheck + vitest) before pushing.

echo "⏳ pre-push: 运行 npm run check（lint + typecheck + vitest）..."
# v7.3.0：首次失败输出完整日志（此前静默失败无法诊断——check 偶发非零退出）
CHECK_LOG="${TMPDIR:-/tmp}/gr-pre-push-check.log"
if ! npm run check >"$CHECK_LOG" 2>&1; then
  echo "❌ pre-push 门禁失败（npm run check）——详见下方日志：" >&2
  tail -40 "$CHECK_LOG" >&2
  exit 1
fi
echo "✅ pre-push 门禁通过"
exit 0
