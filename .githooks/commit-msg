#!/bin/sh
# Game Recommender commit-msg 钩子（v14.33.0：Conventional Commits 1.0.0 全量校验）
# v4.1.2 轻量版（仅查类型前缀）退役——规则集升级：类型白名单 + scope 单词字符集
# （禁逗号多 scope）+ subject ≤72 字符/结尾无句号 + body 空行分隔 + ! 与
# BREAKING CHANGE 一致性。规则实现在 scripts/commit-lint.mjs（钩子与
# npm run lint:commits 区间复查同源，规范详见 CONTRIBUTING.md「提交信息规范」）。

MSG_FILE="$1"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec node "$SCRIPT_DIR/../scripts/commit-lint.mjs" "$MSG_FILE"
