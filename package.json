{
  "name": "game-recommender",
  "version": "14.42.0",
  "description": "游戏雷达 Game Radar - 游戏智能推荐（Chrome MV3 扩展）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run tests/unit && npm run test:sim",
    "test:sim": "vitest run tests/sim/sim-list.mjs tests/sim/sim-badges.mjs tests/sim/sim-detail.mjs tests/sim/sim-float-menu.mjs && vitest run tests/integration",
    "bench": "node scripts/perf-bench.mjs",
    "verify:match": "node scripts/verify-match.mjs",
    "lint": "eslint . --no-warn-ignored --max-warnings 0",
    "lint:commits": "node scripts/commit-lint.mjs",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.content.json",
    "coverage": "vitest run --coverage",
    "install-hooks": "sh scripts/install-hooks.sh",
    "coverage:snapshot": "node scripts/coverage-snapshot.mjs",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "check:imports": "node scripts/check-untracked-imports.mjs",
    "check:refs": "node scripts/check-referenced-paths.mjs",
    "check:docs": "node scripts/check-doc-version.mjs",
    "check:modules": "node scripts/check-module-index.mjs",
    "check:stubs": "node scripts/check-stubs.mjs",
    "check:ext-refs": "node scripts/check-external-refs.mjs",
    "check:first-run": "node scripts/check-first-run.mjs",
    "check:corpus": "node scripts/check-match-corpus.mjs",
    "check:agents-docs": "node scripts/check-agents-docs.mjs",
    "check:dom-sinks": "node scripts/check-dom-sinks.mjs",
    "check:ast": "ast-grep scan",
    "calibrate:budgets": "node scripts/calibrate-budgets.mjs",
    "verify:mutations": "node scripts/mutation-check.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "war:gen": "node scripts/gen-war.mjs --write",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "audit": "npm audit --audit-level=high",
    "test:timed": "node scripts/test-timing.mjs",
    "visual": "node tests/visual-regression.mjs",
    "package": "node scripts/package.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "test:changed": "vitest run --changed",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --fast",
    "bump": "node scripts/bump.mjs",
    "e2e:pw": "node scripts/build.mjs && playwright test -c playwright.config.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.3",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.6",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^4.2.1",
    "fast-check": "^4.9.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.46.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "preact": "^11.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "sideEffects": [
    "**/*.js",
    "**/*.mjs"
  ]
}
