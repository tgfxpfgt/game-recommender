{
  "name": "game-recommender",
  "version": "14.25.0",
  "description": "游戏雷达 Game Radar - 游戏智能推荐（Chrome MV3 扩展）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run tests/unit && npm run test:sim",
    "test:sim": "vitest run tests/sim/sim-list.mjs tests/sim/sim-badges.mjs tests/sim/sim-detail.mjs tests/sim/sim-float-menu.mjs tests/integration",
    "e2e": "node tests/e2e-smoke.mjs",
    "bench": "node scripts/perf-bench.mjs",
    "verify:match": "node scripts/verify-match.mjs",
    "lint": "eslint . --no-warn-ignored --max-warnings 0",
    "check": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.content.json",
    "coverage": "vitest run --coverage",
    "install-hooks": "sh scripts/install-hooks.sh",
    "coverage:snapshot": "node scripts/coverage-snapshot.mjs",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "check:imports": "node scripts/check-untracked-imports.mjs",
    "audit": "npm audit --audit-level=high",
    "test:timed": "node scripts/test-timing.mjs",
    "visual": "node tests/visual-regression.mjs",
    "package": "node scripts/package.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "test:changed": "vitest run --changed",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --fast",
    "bump": "node scripts/bump.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "fast-check": "^4.9.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.45.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
