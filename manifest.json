{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "14.28.4",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "alarms", "notifications", "scripting", "contextMenus", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "gr-force-refresh": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "强制刷新当前页游戏好评率"
    }
  },
  "host_permissions": [
    "http://*.3dmgame.com/*",
    "https://*.3dmgame.com/*",
    "http://*.ali213.net/*",
    "https://*.ali213.net/*",
    "http://*.gamersky.com/*",
    "https://*.gamersky.com/*",
    "http://*.gamer520.com/*",
    "https://*.gamer520.com/*",
    "http://*.gamers520.com/*",
    "https://*.gamers520.com/*",
    "http://*.xianyudanji.gg/*",
    "https://*.xianyudanji.gg/*",
    "http://*.xdgame.com/*",
    "https://*.xdgame.com/*",
    "https://store.steampowered.com/*",
    "https://*.steam250.com/*",
    "https://api.steampowered.com/*",
    "https://steamspy.com/*",
    "https://store-site-backend-official.ak.epicgames.com/*",
    "https://www.gog.com/*",
    "https://www.gamerpower.com/*",
    "https://api.isthereanydeal.com/*",
    "https://cn.bing.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*.xdgame.com/*", "https://*.xdgame.com/*"],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/xdgame.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*.xianyudanji.gg/*", "https://*.xianyudanji.gg/*"],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/xianyudanji.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*.gamer520.com/*",
        "https://*.gamer520.com/*",
        "http://*.gamers520.com/*",
        "https://*.gamers520.com/*"
      ],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/gamer520.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*.3dmgame.com/*", "https://*.3dmgame.com/*"],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/3dmgame.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*.ali213.net/*", "https://*.ali213.net/*"],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/ali213.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*.gamersky.com/*", "https://*.gamersky.com/*"],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/gamersky.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://store.steampowered.com/*", "https://*.steam250.com/*"],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
    "web_accessible_resources": [
      {
        "resources": [
          "content/adapters/builder.js",
          "content/core/common.js",
          "content/core/debug.js",
          "content/core/floats.js",
          "content/core/messages.js",
          "content/core/page-init.js",
          "content/core/page-url.js",
          "content/core/status-bar.js",
          "content/core/steam-rating-logic.js",
          "content/core/timeouts.js",
          "content/detail/candidates.js",
          "content/detail/detail-page.js",
          "content/detail/detail-templates.js",
          "content/detail/detect-name.js",
          "content/detail/inline-card.js",
          "content/detail/qr-unlock.js",
          "content/detail/render/inline-html.js",
          "content/detail/render/rating-rows.js",
          "content/detail/render/sidebar-html.js",
          "content/detail/sidebar-actions.js",
          "content/detail/sidebar-rows.js",
          "content/detail/sidebar.js",
          "content/detail/tracking.js",
          "content/list/badges/badge-base.js",
          "content/list/badges/core.js",
          "content/list/badges/rec.js",
          "content/list/badges/working.js",
          "content/list/filter-presets.js",
          "content/list/list-batch.js",
          "content/list/list-page.js",
          "content/list/list-state.js",
          "content/list/xdgrid-layout.js",
          "content/list/xdgrid-panel.js",
          "content/list/xdgrid.js",
          "content/module-manifest.js",
          "content/tracking/download-tracking.js",
          "lib/vendor/qrcode-reader.js",
          "shared/fm-keys.js",
          "shared/platform-detect.js",
          "shared/retrieval-vocab.js",
          "shared/spy-scales.js"
        ],
        "matches": [
          "http://*.xdgame.com/*",
          "https://*.xdgame.com/*",
          "http://*.xianyudanji.gg/*",
          "https://*.xianyudanji.gg/*",
          "http://*.gamer520.com/*",
          "https://*.gamer520.com/*",
          "http://*.gamers520.com/*",
          "https://*.gamers520.com/*",
          "http://*.3dmgame.com/*",
          "https://*.3dmgame.com/*",
          "http://*.ali213.net/*",
          "https://*.ali213.net/*",
          "http://*.gamersky.com/*",
          "https://*.gamersky.com/*",
          "https://store.steampowered.com/*",
          "https://*.steam250.com/*"
        ]
      }
    ]
}
