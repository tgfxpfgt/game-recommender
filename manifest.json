{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "9.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "alarms", "notifications", "scripting", "contextMenus"],
  "commands": {
    "gr-force-refresh": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "强制刷新当前页游戏好评率"
    }
  },
  "host_permissions": [
    "http://3dmgame.com/*",
    "https://3dmgame.com/*",
    "http://ali213.net/*",
    "https://ali213.net/*",
    "http://gamersky.com/*",
    "https://gamersky.com/*",
    "http://yystv.cn/*",
    "https://yystv.cn/*",
    "http://fitgirl-repacks.site/*",
    "https://fitgirl-repacks.site/*",
    "http://rutracker.org/*",
    "https://rutracker.org/*",
    "http://gamer520.com/*",
    "https://gamer520.com/*",
    "http://xianyudanji.gg/*",
    "https://xianyudanji.gg/*",
    "http://xdgame.com/*",
    "https://xdgame.com/*",
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://steamspy.com/*",
    "https://store-site-backend-official.ak.epicgames.com/*",
    "https://www.gog.com/*",
    "https://www.gamerpower.com/*",
    "https://cn.bing.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.xdgame.com/*",
        "https://*.xdgame.com/*",
        "http://*.xianyudanji.gg/*",
        "https://*.xianyudanji.gg/*",
        "http://*.gamer520.com/*",
        "https://*.gamer520.com/*",
        "http://*.3dmgame.com/*",
        "https://*.3dmgame.com/*",
        "http://*.ali213.net/*",
        "https://*.ali213.net/*",
        "http://*.gamersky.com/*",
        "https://*.gamersky.com/*",
        "https://*.steampowered.com/*"
      ],
      "js": [
        "shared/patterns.js",
        "shared/msg.js",
        "shared/escape.js",
        "adapters/default.js",
        "adapters/sites/xdgame.js",
        "adapters/sites/xianyudanji.js",
        "adapters/sites/gamer520.js",
        "adapters/sites/3dmgame.js",
        "adapters/sites/ali213.js",
        "adapters/sites/gamersky.js",
        "adapters/index.js",
        "content/tracker.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/*.js"],
      "matches": [
        "http://*.xdgame.com/*",
        "https://*.xdgame.com/*",
        "http://*.xianyudanji.gg/*",
        "https://*.xianyudanji.gg/*",
        "http://*.gamer520.com/*",
        "https://*.gamer520.com/*",
        "http://*.3dmgame.com/*",
        "https://*.3dmgame.com/*",
        "http://*.ali213.net/*",
        "https://*.ali213.net/*",
        "http://*.gamersky.com/*",
        "https://*.gamersky.com/*",
        "https://*.steampowered.com/*"
      ]
    }
  ]
}
